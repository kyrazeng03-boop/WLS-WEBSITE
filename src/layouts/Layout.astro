---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import QuickInquiryModal from '../components/QuickInquiryModal.astro';
import { getSiteSettings } from '../lib/sanity';
// 2026-09-02：字体改成本地打包（@fontsource），不再从 Google Fonts 的
// fonts.googleapis.com 实时请求——国内网络访问经常被墙/超时，字体一旦加载失败，
// 浏览器会静默换成系统默认字体，导致标题/正文字体"看起来突然变了"。
// 这几行 import 会被打包工具处理成本地静态字体文件，跟随网站一起发布，不依赖外部网络。
// 2026-09-03：标题+正文统一换成 Public Sans（参考 usa.lighting.philips.com 的字体气质，
// 详见 global.css 里 --font-display/--font-body 那段注释）——不再需要 Space Grotesk/Inter。
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
import '@fontsource/public-sans/600.css';
import '@fontsource/public-sans/700.css';
import '@fontsource/public-sans/800.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/800.css';
import '../styles/global.css';

const {
  title = 'WLS Lighting | Build Healthy Lighting — DOB Lighting Manufacturer',
  description = 'WLS Lighting — Build Healthy Lighting. Factory-direct DOB lighting manufacturer, serving South & Southeast Asia, Middle East and Africa with 20+ countries of export experience.',
} = Astro.props;

let settings = null;
try {
  settings = await getSiteSettings();
} catch (e) {
  // Sanity尚未配置数据时，页面仍可正常渲染（用默认值兜底）
  settings = null;
}
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer settings={settings} />
  <WhatsAppButton number={settings?.whatsapp} />
  <QuickInquiryModal />
</body>
</html>

<script>
  // 全站滚动淡入动画：卡片、区块标题等元素进入视口时轻微上浮淡入
  // 自动应用到常见的内容区块选择器上，不需要在每个页面模板里手动加class
  const targets = document.querySelectorAll(
    '.section-title, .grid > *, .founder-grid > *, .office-card, .positioning-item, .belief-point, .mfg-stat, .why-item, .coop-card, .photo-tile, .faq-item, .cat-photo-tile, .custom-card'
  );
  // 按"同一父级容器内排第几个"记录序号，写入 CSS 变量 --reveal-i，
  // 让同一组卡片/网格项依次错开淡入（而不是全部同时出现）——
  // 用父级分组而不是全局序号，这样每个独立板块的卡片都是从0开始错开，
  // 不会因为页面靠后的板块继承了前面板块的序号而延迟过久。
  const revealGroupCounts = new Map<Element, number>();
  targets.forEach((el) => {
    el.classList.add('reveal');
    const parent = el.parentElement;
    const i = parent ? (revealGroupCounts.get(parent) ?? 0) : 0;
    if (parent) revealGroupCounts.set(parent, i + 1);
    (el as HTMLElement).style.setProperty('--reveal-i', String(Math.min(i, 6)));
  });

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );

  targets.forEach((el) => observer.observe(el));
</script>

<script>
  // 中英文切换：只切换固定界面文字（data-i18n标记的元素），产品/新闻等CMS内容保持原文
  import { translations } from '../lib/i18n';

  const STORAGE_KEY = 'wls-lang';

  function applyLang(lang: string) {
    document.documentElement.lang = lang === 'zh' ? 'zh-CN' : 'en';

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      const entry = key ? (translations as Record<string, Record<string, string>>)[key] : null;
      if (entry && entry[lang]) {
        el.innerHTML = entry[lang];
      }
    });

    document.querySelectorAll('[data-i18n-placeholder]').forEach((el) => {
      const key = el.getAttribute('data-i18n-placeholder');
      const entry = key ? (translations as Record<string, Record<string, string>>)[key] : null;
      if (entry && entry[lang] && el instanceof HTMLInputElement) {
        el.placeholder = entry[lang];
      }
    });

    document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
      btn.classList.toggle('is-active', btn.getAttribute('data-lang-btn') === lang);
    });
  }

  function getLang() {
    return localStorage.getItem(STORAGE_KEY) || 'en';
  }

  function setLang(lang: string) {
    localStorage.setItem(STORAGE_KEY, lang);
    applyLang(lang);
  }

  applyLang(getLang());

  document.querySelectorAll('[data-lang-btn]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setLang(btn.getAttribute('data-lang-btn') || 'en');
    });
  });
</script>
