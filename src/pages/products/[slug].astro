---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProducts, getProductBySlug, urlFor } from '../../lib/sanity';
import { productCategoryLabels } from '../../lib/categories';
import { companyAdvantages, productFAQs } from '../../lib/content';

export async function getStaticPaths() {
  try {
    const products = await getAllProducts();
    return products.map((p) => ({ params: { slug: p.slug.current } }));
  } catch (e) {
    return [];
  }
}

const { slug } = Astro.params;
const product = await getProductBySlug(slug);

if (!product) {
  return Astro.redirect('/products');
}

// 不强制裁成4:3——保留图片原始比例，交给前端用 object-fit: contain 完整显示，
// 避免部分图片（带Logo/标题的宣传图、尺寸标注图）被裁掉文字或留白错位
const coverUrl = product.coverImage ? urlFor(product.coverImage).width(1200).url() : '/images/placeholder-product.jpg';
const galleryUrls = (product.gallery || []).map((img) => urlFor(img).width(1200).url());
// 主图轮播用的完整图片列表：封面图 + 图集，供左右箭头切换
const allImages = [coverUrl, ...galleryUrls];

// 2026-09-02：不同产品/不同图片的原始比例其实不一样（有的是方图，有的是4:3实拍图，
// 有的是带Logo文案的宣传长图），之前主图框写死 aspect-ratio 会导致跟封面图比例不一致时
// 两侧/上下出现大片空白。这里直接从Sanity图片资源的文件名里解析出封面图的原始宽高
// （Sanity图片_ref格式形如 "image-<hash>-800x800-jpg"，宽高就编码在文件名里），
// 让主图框的比例跟封面图保持一致，消除多余留白。解析失败时兜底用4:3。
function getImageRatio(source) {
  const ref = source?.asset?._ref || '';
  const match = ref.match(/-(\d+)x(\d+)-/);
  if (match) {
    return `${match[1]} / ${match[2]}`;
  }
  return '4 / 3';
}
const mainImageRatio = getImageRatio(product.coverImage);
const categoryLabel = productCategoryLabels[product.category] || product.category;

// 同系列推荐 —— 排除当前产品本身，最多展示3个
let relatedProducts = [];
try {
  const allProducts = await getAllProducts();
  relatedProducts = allProducts
    .filter((p) => p.category === product.category && p.slug?.current !== slug)
    .slice(0, 4);
} catch (e) {
  relatedProducts = [];
}
---
<Layout title={`${product.name} | WLS Lighting`} description={product.shortDescription}>
  <section class="section" style="padding-top: 48px;">
    <div class="container product-detail">
      <div class="product-detail__media">
        <div class="product-detail__main-image" id="productCarousel" style={`aspect-ratio: ${mainImageRatio};`}>
          {allImages.map((url, i) => (
            <img src={url} alt={product.name} class={`carousel-img ${i === 0 ? 'active' : ''}`} data-index={i} />
          ))}
          {allImages.length > 1 && (
            <>
              <button class="carousel-arrow carousel-arrow--prev" id="prevImg" aria-label="Previous image">‹</button>
              <button class="carousel-arrow carousel-arrow--next" id="nextImg" aria-label="Next image">›</button>
            </>
          )}
        </div>
        {allImages.length > 1 && (
          <div class="product-detail__thumbs">
            {allImages.map((url, i) => (
              <img src={url} alt={product.name} class={`thumb-img ${i === 0 ? 'active' : ''}`} data-index={i} />
            ))}
          </div>
        )}
      </div>

      <div class="product-detail__info">
        <a href={`/products/category/${product.category}`} class="eyebrow" data-i18n={`cat.${product.category}`}>{categoryLabel}</a>
        <h1>{product.name}</h1>
        <p>{product.shortDescription}</p>

        <ul class="advantages-list" id="advantages">
          {companyAdvantages.map((a) => (
            <li set:html={a} />
          ))}
        </ul>

        <nav class="jump-nav">
          <a href="#specs" data-i18n="products.jumpnav.specs">Tech Specs</a>
          {product.documents && product.documents.length > 0 && (
            <a href="#downloads" data-i18n="products.jumpnav.downloads">Downloads</a>
          )}
          <a href="#advantages" data-i18n="products.jumpnav.why">Why WLS</a>
          <a href="#faq" data-i18n="products.jumpnav.faq">FAQs</a>
        </nav>

        {product.specs && product.specs.length > 0 && (
          <>
            <h3 class="specs-heading" data-i18n="products.specsHeading">Specifications</h3>
            <div class="specs-grid" id="specs">
              {product.specs.map((s) => (
                <div class={`spec-card ${s.value && s.value.includes(' / ') ? 'spec-card--wide' : ''}`}>
                  <span class="spec-card__label">{s.label}</span>
                  <span class="spec-card__value">{s.value}</span>
                </div>
              ))}
            </div>
          </>
        )}

        {product.documents && product.documents.length > 0 && (
          <>
            <h3 class="specs-heading" id="downloads" data-i18n="products.downloadsHeading">Downloads</h3>
            <div class="doc-grid">
              {product.documents.map((d) => (
                d.fileUrl && (
                  <a href={d.fileUrl} target="_blank" rel="noopener" class="doc-card" download={d.fileName || true}>
                    <span class="doc-card__icon">PDF</span>
                    <span class="doc-card__name">{d.title || d.fileName || 'Document'}</span>
                  </a>
                )
              ))}
            </div>
          </>
        )}

        <div class="product-detail__actions">
          <button type="button" class="btn btn--primary js-inquiry-btn" data-product={product.name} data-i18n="btn.inquiryNow">Inquiry Now</button>
          <a href="https://wa.me/8615807600815" target="_blank" rel="noopener" class="btn btn--outline-dark" data-i18n="btn.chatWhatsApp">Chat On WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Product Recommendation -->
  {relatedProducts.length > 0 && (
    <section class="section" style="padding-top:0;">
      <div class="container">
        <span class="eyebrow" data-i18n="products.recommendation.eyebrow">Product Recommendation</span>
        <h2 class="section-title" style="margin-bottom:32px;" data-i18n="products.recommendation.title">Related Products</h2>
        <div class="grid grid--4">
          {relatedProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ -->
  <section class="section faq-section" id="faq" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow" data-i18n="products.faq.eyebrow">Frequently Asked</span>
      <h2 class="section-title" data-i18n="products.faq.title">FAQ</h2>
      <div class="faq-list">
        {productFAQs.map((item, i) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .section-title { font-size: clamp(27px, 3.4vw, 36px); max-width: 680px; }
  .jump-nav {
    display: flex;
    gap: 4px;
    border-bottom: 1px solid var(--line);
    margin: 24px 0;
  }
  .jump-nav a {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
    padding: 10px 16px 10px 0;
    margin-right: 16px;
    border-bottom: 2px solid transparent;
  }
  .jump-nav a:hover { color: var(--glow); border-color: var(--glow-soft); }

  .faq-section { background: var(--section-wash); padding-top: 56px; }
  .faq-list {
    max-width: 760px;
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .faq-item {
    background: #fff;
    border: 1px solid var(--line);
    padding: 18px 22px;
  }
  .faq-item summary {
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .faq-item summary::after {
    content: '+';
    font-size: 20px;
    color: var(--glow);
    margin-left: 12px;
    flex-shrink: 0;
  }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    margin: 12px 0 0;
    font-size: 14px;
    color: var(--text-muted);
  }
</style>

<style>
  .product-detail {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
  }
  .product-detail__main-image {
    position: relative;
    aspect-ratio: 4/3; /* 兜底比例：实际比例由页面内联样式按封面图原始尺寸动态设置，见上方frontmatter */
    overflow: hidden;
    background: var(--paper-soft);
  }
  .carousel-img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: contain;
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .carousel-img.active { opacity: 1; }
  .carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px; height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.85);
    color: var(--ink);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s ease;
  }
  .carousel-arrow:hover { background: #fff; color: var(--glow); }
  .carousel-arrow--prev { left: 14px; }
  .carousel-arrow--next { right: 14px; }

  .product-detail__thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 10px;
  }
  .thumb-img {
    aspect-ratio: 1/1;
    object-fit: contain;
    background: var(--paper-soft);
    cursor: pointer;
    opacity: 0.55;
    border: 2px solid transparent;
    transition: all 0.2s ease;
  }
  .thumb-img:hover { opacity: 0.85; }
  .thumb-img.active { opacity: 1; border-color: var(--glow); }

  .badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--steel);
    border: 1px solid var(--line);
    padding: 6px 12px;
    margin-bottom: 24px;
  }

  .specs-heading {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    margin: 4px 0 14px;
  }
  .specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-bottom: 8px;
  }
  .spec-card {
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 16px 18px;
    transition: border-color 0.2s ease;
  }
  .spec-card:hover { border-color: var(--glow-soft); }
  .spec-card--wide { grid-column: 1 / -1; }
  .spec-card__label {
    display: block;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: normal;
    text-transform: none;
    color: var(--steel);
    margin-bottom: 6px;
  }
  .spec-card__value {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    color: var(--ink);
  }
  @media (max-width: 480px) {
    .specs-grid { grid-template-columns: 1fr; }
  }

  .doc-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }
  .doc-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 10px 16px;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .doc-card:hover { border-color: var(--glow-soft); color: var(--glow); }
  .doc-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px; height: 28px;
    border-radius: 6px;
    background: var(--glow);
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }
  .advantages-list {
    list-style: none;
    margin: 18px 0 26px;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .advantages-list li {
    position: relative;
    padding-left: 22px;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-muted);
  }
  .advantages-list li::before {
    content: '';
    position: absolute;
    left: 0; top: 7px;
    width: 8px; height: 8px;
    background: var(--glow);
    border-radius: 2px;
  }
  .product-detail__actions {
    display: flex;
    gap: 14px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  @media (max-width: 860px) {
    .product-detail { grid-template-columns: 1fr; }
  }
</style>

<script>
  const carousel = document.getElementById('productCarousel');
  const images = document.querySelectorAll('.carousel-img');
  const thumbs = document.querySelectorAll('.thumb-img');
  const prevBtn = document.getElementById('prevImg');
  const nextBtn = document.getElementById('nextImg');
  let current = 0;

  function goTo(index: number) {
    const total = images.length;
    const i = ((index % total) + total) % total;
    images.forEach((img) => img.classList.remove('active'));
    thumbs.forEach((t) => t.classList.remove('active'));
    images[i]?.classList.add('active');
    thumbs[i]?.classList.add('active');
    current = i;
  }

  // 主图自动轮播：每4.5秒自动切到下一张，鼠标悬停时暂停
  const AUTO_INTERVAL = 4500;
  let autoTimer: ReturnType<typeof setInterval> | null = null;

  function startAuto() {
    if (images.length <= 1) return;
    stopAuto();
    autoTimer = setInterval(() => goTo(current + 1), AUTO_INTERVAL);
  }
  function stopAuto() {
    if (autoTimer) {
      clearInterval(autoTimer);
      autoTimer = null;
    }
  }

  prevBtn?.addEventListener('click', () => { goTo(current - 1); startAuto(); });
  nextBtn?.addEventListener('click', () => { goTo(current + 1); startAuto(); });
  thumbs.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const index = parseInt(thumb.getAttribute('data-index') || '0', 10);
      goTo(index);
      startAuto();
    });
  });

  carousel?.addEventListener('mouseenter', stopAuto);
  carousel?.addEventListener('mouseleave', startAuto);
  startAuto();
</script>
