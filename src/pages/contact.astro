---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import OfficesSection from '../components/OfficesSection.astro';

const productParam = Astro.url.searchParams.get('product');
const prefill = productParam ? `I'm interested in: ${productParam}` : '';
---
<Layout title="Contact Us | WLS Lighting" description="Get in touch with WLS Lighting for pricing, samples or partnership inquiries. WhatsApp, email and factory address included.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-i18n="contact.hero.eyebrow">Contact Us</span>
      <h1 data-i18n="contact.hero.title">Let's Talk about Your Project</h1>
      <p>Send us your requirements and our overseas sales team will respond within 1 business day. For faster replies, message us directly on WhatsApp.</p>
    </div>
  </section>

  <section class="section contact-form-section">
    <div class="container contact-form-inner">
      <div class="contact-form-intro">
        <span class="eyebrow" data-i18n="contact.form.eyebrow">Get in Touch</span>
        <h2 class="section-title" data-i18n="contact.form.title">Tell Us What You're Looking For</h2>
        <p>Include your target specs, order quantity and destination country — the more detail you share, the faster we can send accurate pricing and samples.</p>
      </div>
      <div class="contact-form-wrap">
        <ContactForm prefillSubject={prefill} />
      </div>
    </div>
  </section>

  <OfficesSection />
</Layout>

<style>
  .page-hero {
    background: var(--section-wash);
    color: var(--ink);
    padding: 52px 0 36px;
  }
  .page-hero h1 { font-size: clamp(34px, 4.5vw, 52px); max-width: 100%; }
  .page-hero p { max-width: 100%; color: var(--text-muted); }

  .contact-form-section { padding-bottom: 0; }
  .contact-form-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-form-intro { margin-bottom: 32px; }
  .contact-form-intro .eyebrow { justify-content: center; }
  .section-title { font-size: clamp(27px, 3.4vw, 36px); }
  .contact-form-intro .section-title { margin: 0 auto 12px; }
  .contact-form-intro p { max-width: 560px; margin: 0 auto; }
  .contact-form-wrap { text-align: left; }

  .contact-form-wrap {
    background: #fff;
    border: 1px solid var(--line);
    padding: 40px;
  }
</style>
