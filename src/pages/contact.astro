---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getSiteSettings } from '../lib/sanity';

let settings = null;
try {
  settings = await getSiteSettings();
} catch (e) {
  settings = null;
}

const productParam = Astro.url.searchParams.get('product');
const prefill = productParam ? `I'm interested in: ${productParam}` : '';

const phone = settings?.phone || '+86 158 0760 0815';
const email = settings?.email || 'export@wlsdoblighting.com';
const address = settings?.address || '4th north, east bank road, Guzhen town, Zhongshan, GD, China';
const workingHours = settings?.workingHours || '09:00-19:30 Mon-Sat';

// Egypt factory contact — WeChat and WhatsApp share the same number
const egyptPhone = '+86 180 2566 6567';
const egyptEmail = 'darren@wlsdoblighting.com';

const offices = [
  {
    name: 'Head Office — China',
    address: "No. 4, North Side of Cao'er East Road, Guzhen Town, Zhongshan City, Guangdong Province, China",
  },
  {
    name: 'Egypt Office',
    address: '10th of Ramadan City, A6 CAIRO, WLS',
  },
];
---
<Layout title="Contact Us | WLS Lighting" description="Get in touch with WLS Lighting for pricing, samples or partnership inquiries. WhatsApp, email and factory address included.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-i18n="contact.hero.eyebrow">Contact Us</span>
      <h1 data-i18n="contact.hero.title">Let's Talk About Your Project</h1>
      <p>Send us your requirements and our overseas sales team will respond within 1 business day. For faster replies, message us directly on WhatsApp.</p>
    </div>
  </section>

  <section class="section contact-form-section">
    <div class="container contact-form-inner">
      <div class="contact-form-intro">
        <span class="eyebrow" data-i18n="contact.form.eyebrow">Get In Touch</span>
        <h2 class="section-title" data-i18n="contact.form.title">Tell Us What You're Looking For</h2>
        <p>Include your target specs, order quantity and destination country — the more detail you share, the faster we can send accurate pricing and samples.</p>
      </div>
      <div class="contact-form-wrap">
        <ContactForm prefillSubject={prefill} />
      </div>
    </div>
  </section>

  <!-- Office locations: contact details + map paired together per office -->
  <section class="section offices-section">
    <div class="container">
      <span class="eyebrow" data-i18n="contact.offices.eyebrow">Our Offices</span>
      <h2 class="section-title" style="margin-bottom:32px;" data-i18n="contact.offices.title">Two Locations, One Standard</h2>

      <div class="office-row">
        <div class="contact-panel">
          <span class="eyebrow" style="color: rgba(255,255,255,0.75);" data-i18n="contact.office.china">China Factory</span>
          <div class="info-block">
            <span class="info-icon">💬</span>
            <div>
              <span class="info-label" data-i18n="contact.label.whatsappRecommended">WhatsApp (Recommended)</span>
              <a href={`https://wa.me/${phone.replace(/[^0-9]/g,'')}`} target="_blank" rel="noopener" class="info-value">{phone}</a>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">✉</span>
            <div>
              <span class="info-label" data-i18n="contact.label.email">Email</span>
              <a href={`mailto:${email}`} class="info-value">{email}</a>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">🕐</span>
            <div>
              <span class="info-label" data-i18n="contact.label.workingHours">Working Hours</span>
              <p class="info-value">{workingHours}</p>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">📍</span>
            <div>
              <span class="info-label" data-i18n="contact.label.factoryAddress">Factory Address</span>
              <p class="info-value">{address}</p>
            </div>
          </div>
          <div class="qr-row">
            <div class="qr-box qr-box--filled">
              <img src="/images/qr/wechat-china.png" alt="WeChat QR code" />
              <span class="qr-box__label" data-i18n="contact.qr.wechat">WeChat</span>
            </div>
            <div class="qr-box qr-box--filled">
              <img src="/images/qr/whatsapp-china.png" alt="WhatsApp QR code" />
              <span class="qr-box__label" data-i18n="contact.qr.whatsapp">WhatsApp</span>
            </div>
          </div>
        </div>
        <div class="office-map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(offices[0].address)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map to ${offices[0].name}`}
          ></iframe>
        </div>
      </div>

      <div class="office-row">
        <div class="contact-panel">
          <span class="eyebrow" style="color: rgba(255,255,255,0.75);" data-i18n="contact.office.egypt">Egypt Factory</span>
          <div class="info-block">
            <span class="info-icon">💬</span>
            <div>
              <span class="info-label" data-i18n="contact.label.whatsappWechat">WhatsApp / WeChat</span>
              <a href={`https://wa.me/${egyptPhone.replace(/[^0-9]/g,'')}`} target="_blank" rel="noopener" class="info-value">{egyptPhone}</a>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">✉</span>
            <div>
              <span class="info-label" data-i18n="contact.label.email">Email</span>
              <a href={`mailto:${egyptEmail}`} class="info-value">{egyptEmail}</a>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">🕐</span>
            <div>
              <span class="info-label" data-i18n="contact.label.workingHours">Working Hours</span>
              <p class="info-value">{workingHours}</p>
            </div>
          </div>
          <div class="info-block">
            <span class="info-icon">📍</span>
            <div>
              <span class="info-label" data-i18n="contact.label.factoryAddress">Factory Address</span>
              <p class="info-value">{offices[1].address}</p>
            </div>
          </div>
          <div class="qr-row">
            <div class="qr-box">
              <span class="qr-box__label" data-i18n="contact.qr.wechat">WeChat</span>
              <span class="qr-box__hint" data-i18n="contact.qr.comingSoon">QR coming soon</span>
            </div>
            <div class="qr-box">
              <span class="qr-box__label" data-i18n="contact.qr.whatsapp">WhatsApp</span>
              <span class="qr-box__hint" data-i18n="contact.qr.comingSoon">QR coming soon</span>
            </div>
          </div>
        </div>
        <div class="office-map">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(offices[1].address)}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map to ${offices[1].name}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: var(--section-wash);
    color: var(--ink);
    padding: 52px 0 36px;
  }
  .page-hero h1 { font-size: clamp(34px, 4.5vw, 52px); max-width: 100%; }
  .page-hero p { max-width: 100%; color: var(--text-muted); }

  .contact-form-section { padding-bottom: 0; }
  .contact-form-inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .contact-form-intro { margin-bottom: 32px; }
  .contact-form-intro .eyebrow { justify-content: center; }
  .section-title { font-size: clamp(27px, 3.4vw, 36px); }
  .contact-form-intro .section-title { margin: 0 auto 12px; }
  .contact-form-intro p { max-width: 560px; margin: 0 auto; }
  .contact-form-wrap { text-align: left; }

  .offices-section { border-top: 1px solid var(--line); }

  .office-row {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    margin-bottom: 24px;
  }
  .office-row:last-child { margin-bottom: 0; }
  .office-row .office-map { min-height: 340px; }

  .contact-panel {
    background: var(--ink);
    color: #fff;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-panel .eyebrow {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .qr-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    border-top: 1px solid rgba(255,255,255,0.2);
    padding-top: 18px;
  }
  .qr-box {
    aspect-ratio: 1/1;
    border: 1px dashed rgba(255,255,255,0.45);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    padding: 8px;
  }
  .qr-box__label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .qr-box__hint {
    font-size: 11px;
    color: rgba(255,255,255,0.65);
  }
  .qr-box--filled {
    background: #fff;
    border: 1px solid var(--line-onDark);
    justify-content: flex-start;
    padding: 10px 10px 8px;
  }
  .qr-box--filled img {
    width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: contain;
    border-radius: 2px;
  }
  .qr-box--filled .qr-box__label {
    color: var(--ink);
  }
  .info-block {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    border-top: 1px solid rgba(255,255,255,0.2);
    padding-top: 18px;
  }
  .info-icon { font-size: 20px; line-height: 1.3; }
  .info-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.7);
    margin-bottom: 4px;
  }
  .info-value {
    display: block;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    color: #fff;
    margin: 0;
  }
  a.info-value:hover { color: rgba(255,255,255,0.8); }

  .contact-form-wrap {
    background: #fff;
    border: 1px solid var(--line);
    padding: 40px;
  }

  .office-map {
    background: var(--paper-soft);
  }
  .office-map iframe {
    width: 100%; height: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 860px) {
    .office-row { grid-template-columns: 1fr; }
    .office-row .office-map { min-height: 260px; }
  }
</style>
