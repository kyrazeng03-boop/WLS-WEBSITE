---
import Layout from '../../layouts/Layout.astro';
import { getAllNews, getNewsBySlug, urlFor } from '../../lib/sanity';
// 正文内容使用下方脚本做简化版 Portable Text 渲染，不依赖额外的 React 包

export async function getStaticPaths() {
  try {
    const news = await getAllNews();
    return news.map((n) => ({ params: { slug: n.slug.current } }));
  } catch (e) {
    return [];
  }
}

const { slug } = Astro.params;
const article = await getNewsBySlug(slug);

if (!article) {
  return Astro.redirect('/news');
}

const coverUrl = article.coverImage ? urlFor(article.coverImage).width(1200).height(600).url() : '/images/placeholder-news.jpg';
const date = article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---
<Layout title={`${article.title} | WLS Lighting News`} description={article.summary}>
  <article class="section" style="padding-top: 48px;">
    <div class="container article-header">
      <span class="eyebrow">{date}</span>
      <h1>{article.title}</h1>
    </div>
    <div class="container article-cover">
      <img src={coverUrl} alt={article.title} />
    </div>
    <div class="container article-body" id="articleBody" data-body={JSON.stringify(article.body || [])}>
      <!-- Portable Text 内容通过下方脚本渲染成简单HTML -->
    </div>
    <div class="container article-cta">
      <p data-i18n="news.cta.text">Interested in working with WLS Lighting?</p>
      <a href="/contact" class="btn btn--primary" data-i18n="footer.ctaBtn">Contact Us</a>
    </div>
  </article>
</Layout>

<style>
  .article-header { max-width: 760px; margin: 0 auto 32px; text-align: center; }
  .article-header h1 { font-size: clamp(24px, 3.2vw, 36px); }
  /* 封面图跟标题/正文用同一个 max-width（760px），左右两端对齐 —— 之前图片是
     960px，比文字的760px宽，导致图片和文字两边看起来没对齐 */
  .article-cover { max-width: 760px; margin: 0 auto 40px; }
  .article-cover img { aspect-ratio: 16/8; object-fit: cover; }
  .article-body {
    max-width: 760px;
    margin: 0 auto;
    font-size: 17px;
    line-height: 1.8;
  }
  .article-body :global(p) { margin-bottom: 1.2em; color: var(--ink); }
  .article-body :global(img) { margin: 24px 0; }
  .article-cta {
    max-width: 720px;
    margin: 56px auto 0;
    padding-top: 32px;
    border-top: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  @media (max-width: 600px) {
    .article-cta { flex-direction: column; gap: 16px; align-items: flex-start; }
  }
</style>

<script>
  // 简化版 Portable Text 渲染（避免引入额外的React依赖）
  const el = document.getElementById('articleBody');
  if (el) {
    const blocks = JSON.parse(el.dataset.body || '[]');
    el.innerHTML = blocks
      .map((block: any) => {
        if (block._type === 'block') {
          const text = (block.children || []).map((c: any) => c.text).join('');
          return `<p>${text}</p>`;
        }
        if (block._type === 'image' && block.asset) {
          return `<img src="${block.asset.url || ''}" alt="" />`;
        }
        return '';
      })
      .join('');
  }
</script>
