---
import Layout from '../layouts/Layout.astro';
import { getAboutPage, urlFor } from '../lib/sanity';

let aboutData = null;
try {
  aboutData = await getAboutPage();
} catch (e) {
  // Sanity尚未配置数据时，页面仍可渲染，下面用占位图兜底
}

const milestones = [
  { year: '2013', text: 'DOB lighting items promoted into multiple countries.', icon: 'flag', tag: 'Multi-country launch' },
  { year: '2017', text: 'Established WLS Lighting overseas factory in Egypt.', icon: 'factory', tag: 'Egypt factory' },
  { year: '2023', text: 'Sales network expanded to over 20 countries and regions.', icon: 'globe', tag: '20+ countries' },
  { year: '2025', text: 'Continued growth across India, Middle East and African markets.', icon: 'growth', tag: 'India · Middle East · Africa' },
];

const milestoneIcons = {
  flag: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 21V4"/><path d="M5 4s1.2-1 4-1 4.5 2 7.5 2 3.5-1 3.5-1v10s-1 1-3.5 1-4.5-2-7.5-2-4 1-4 1"/></svg>',
  factory: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V11l5 3v-3l5 3v-3l5 3v7z"/><path d="M3 21h18"/><path d="M8 21v-4"/><path d="M13 21v-4"/></svg>',
  globe: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a14 14 0 0 1 3.2 9 14 14 0 0 1-3.2 9 14 14 0 0 1-3.2-9A14 14 0 0 1 12 3z"/></svg>',
  growth: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9.5 10.5 13.5 14.5 21 6"/><polyline points="14 6 21 6 21 13"/></svg>',
};

// ⚠️ 占位数字 — 需要替换成公司真实数据，用户已确认这些不是真实数字
const manufacturingStats = [
  { value: 'XXX', label: 'Employees' },
  { value: 'XX', label: 'Engineers' },
  { value: 'X,XXXsqm', label: 'Intelligent Show Room' },
  { value: 'X,XXXsqm', label: 'CNAS Laboratory' },
  { value: 'XX,XXXsqm', label: 'Manufacturing Workshop' },
  { value: 'XXX+', label: 'Patents' },
];

// ---- 图片：Sanity有数据就用，没有就用现成的占位图兜底 ----
const factoryImageUrl = aboutData?.factoryImage ? urlFor(aboutData.factoryImage).width(1200).height(900).url() : '/images/factory-1.jpg';

const fallbackEquipmentCaptions = ['R&amp;D lab', 'Testing equipment', 'Production line', 'Quality inspection'];
const equipmentPhotos = (aboutData?.equipmentPhotos && aboutData.equipmentPhotos.length > 0)
  ? aboutData.equipmentPhotos.map((p) => ({ url: urlFor(p.image).width(1200).height(900).url(), caption: p.caption || '' }))
  : fallbackEquipmentCaptions.map((caption) => ({ url: '/images/equipment-photo.jpg', caption }));

const workshopPhotoUrls = (aboutData?.workshopPhotos && aboutData.workshopPhotos.length > 0)
  ? aboutData.workshopPhotos.map((img) => urlFor(img).width(1200).height(900).url())
  : new Array(6).fill('/images/workshop-photo.jpg');
---
<Layout title="About Us | WLS Lighting" description="WLS Lighting builds healthy, reliable lighting — DOB light source panels manufactured in Zhongshan and Egypt for 20+ export markets.">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow" data-i18n="about.hero.eyebrow">About Us</span>
      <h1 data-i18n="about.hero.title">An innovator in DOB manufacturing, built on a healthy-lighting standard.</h1>
      <p>WLS Lighting is a light source panel and DOB (Driver-on-Board) lighting solution supplier headquartered in Zhongshan, Guangdong, China, with an additional factory in Egypt serving the Middle East and African markets directly.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div class="about-media">
        <img src={factoryImageUrl} alt="WLS Lighting factory production line" />
      </div>
      <div class="about-copy">
        <span class="eyebrow" data-i18n="about.strength.eyebrow">Manufacturing Strength</span>
        <h2 class="section-title" data-i18n="about.strength.title">Two factories, one quality standard</h2>
        <p>Our Zhongshan headquarters runs full production lines for light source panels and DOB drivers, from raw materials through to finished, tested product. Our Egypt facility extends that same standard closer to Middle Eastern and African customers, shortening lead times and simplifying logistics.</p>
        <p>Every batch goes through structured quality checks before it leaves the factory — because for our distributors and project partners, consistency across container loads matters as much as the spec sheet.</p>
      </div>
    </div>
  </section>

  <section class="section milestones-section">
    <div class="milestones-map" aria-hidden="true"></div>
    <div class="container" style="position:relative; z-index:1;">
      <span class="eyebrow" data-i18n="about.milestones.eyebrow">Company Milestones</span>
      <h2 class="section-title" data-i18n="about.milestones.title">A decade of building export relationships</h2>

      <div class="milestones">
        {milestones.map((m, i) => (
          <div class="milestone">
            <span class="milestone__index">{`0${i + 1}`}</span>
            <div class="milestone__icon" set:html={milestoneIcons[m.icon]} />
            <div class="milestone__year">{m.year}</div>
            <p>{m.text}</p>
            <span class="milestone__tag">{m.tag}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Manufacturing Center stats — ⚠️ 占位数字，等待真实数据替换 -->
  <section class="section mfg-center">
    <div class="container">
      <span class="eyebrow" data-i18n="about.mfg.eyebrow">By The Numbers</span>
      <h2 class="section-title" data-i18n="about.mfg.title">Manufacturing Center</h2>
      <p class="mfg-note">⚠ Placeholder figures — replace with real company data</p>
      <div class="grid grid--3 mfg-grid">
        {manufacturingStats.map((s) => (
          <div class="mfg-stat">
            <div class="mfg-stat__value">{s.value}</div>
            <div class="mfg-stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- R&D / Testing equipment photos -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow" data-i18n="about.rd.eyebrow">R&amp;D &amp; Testing</span>
      <h2 class="section-title" style="margin-bottom:32px;" data-i18n="about.rd.title">Die-casting, machining &amp; quality testing</h2>
      <div class="grid grid--4">
        {equipmentPhotos.map((p) => (
          <div class="photo-tile">
            <img src={p.url} alt={p.caption} />
            <span>{p.caption}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Workshop photo wall -->
  <section class="section" style="padding-top:0;">
    <div class="container">
      <span class="eyebrow" data-i18n="about.workshop.eyebrow">Inside WLS</span>
      <h2 class="section-title" style="margin-bottom:32px;" data-i18n="about.workshop.title">Workshop Glance</h2>
      <div class="grid grid--3">
        {workshopPhotoUrls.map((url, i) => (
          <div class="photo-tile">
            <img src={url} alt={`WLS Lighting workshop photo ${i + 1}`} />
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<style>
  .page-hero {
    background: var(--section-wash);
    color: var(--ink);
    padding: 64px 0 48px;
  }
  .page-hero h1 { font-size: clamp(34px, 4.5vw, 52px); max-width: 100%; }
  .page-hero p { max-width: 100%; color: var(--text-muted); }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .about-media img { aspect-ratio: 4/3; object-fit: cover; }
  .section-title { font-size: clamp(27px, 3.4vw, 36px); }

  /* ---- Milestones：世界地图背景 + 出口航线，呼应"十年出口关系"的主题 ---- */
  .milestones-section {
    position: relative;
    overflow: hidden;
    background: var(--section-wash);
    background-image: radial-gradient(circle at 1px 1px, rgba(23,19,28,0.1) 1px, transparent 0);
    background-size: 28px 28px;
  }
  .milestones-map {
    position: absolute;
    inset: 0;
    background-image: url('/images/world-map-routes.png');
    background-repeat: no-repeat;
    background-position: center 60%;
    background-size: 115% auto;
    opacity: 0.9;
    pointer-events: none;
  }

  .milestones {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-top: 64px;
  }
  .milestones::before {
    content: '';
    position: absolute;
    top: 32px;
    left: 32px;
    right: calc(25% - 32px);
    height: 1px;
    background: var(--line);
  }
  .milestones::after {
    content: '';
    position: absolute;
    top: 32px;
    left: 32px;
    right: calc(25% - 32px);
    height: 2px;
    background: linear-gradient(90deg, var(--glow-deep), var(--glow), var(--glow-soft));
    box-shadow: 0 0 14px 0 rgba(164,0,130,0.3);
  }
  .milestone {
    position: relative;
    text-align: left;
    background: rgba(255,255,255,0.62);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255,255,255,0.8);
    border-radius: 14px;
    padding: 22px 20px 24px;
    box-shadow: 0 18px 40px -26px rgba(23,19,28,0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .milestone:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -22px rgba(23,19,28,0.4);
  }
  .milestone__index {
    position: absolute;
    top: 18px;
    right: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--steel);
    opacity: 0.7;
  }
  .milestone__icon {
    position: relative;
    z-index: 2;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 0 20px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--glow-soft);
    box-shadow: 0 0 0 6px var(--section-wash), 0 10px 22px -10px rgba(23,19,28,0.45);
    transition: transform 0.25s ease, color 0.25s ease;
  }
  .milestone__icon svg { width: 26px; height: 26px; }
  .milestone:hover .milestone__icon {
    transform: scale(1.08);
    color: #fff;
  }
  .milestone__year {
    font-family: var(--font-display);
    font-size: 27px;
    color: var(--ink);
    font-weight: 700;
    margin-bottom: 10px;
  }
  .milestone p {
    font-size: 14px;
    color: var(--text-muted);
    max-width: 220px;
    margin: 0 0 14px;
  }
  .milestone__tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--glow-deep);
    background: var(--glow-pale);
    border: 1px solid rgba(164,0,130,0.18);
    border-radius: 999px;
    padding: 5px 12px;
  }

  .mfg-center { background: var(--paper-soft); }
  .mfg-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: #b45309;
    background: #fef3c7;
    display: inline-block;
    padding: 6px 12px;
    margin: 12px 0 0;
  }
  .mfg-grid { margin-top: 32px; }
  .mfg-stat {
    background: #fff;
    border: 1px solid var(--line);
    padding: 26px;
    text-align: center;
  }
  .mfg-stat__value {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 700;
    color: var(--glow);
  }
  .mfg-stat__label {
    font-size: 13px;
    color: var(--text-muted);
    margin-top: 6px;
  }

  .photo-tile {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
    background: var(--paper-soft);
  }
  .photo-tile img { width: 100%; height: 100%; object-fit: cover; }
  .photo-tile span {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: rgba(14,18,32,0.75);
    color: #fff;
    font-size: 12px;
    padding: 6px 10px;
  }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-media { order: -1; }
    .milestones { grid-template-columns: repeat(2, 1fr); row-gap: 24px; margin-top: 32px; }
    .milestones::before, .milestones::after { display: none; }
    .milestones-map { background-size: 220% auto; background-position: center 40%; opacity: 0.7; }
  }
</style>
