---
const { prefillSubject = '', formType = 'inquiry' } = Astro.props;
---
<form class="contact-form" id="contactForm" data-form-type={formType}>
  <div class="form-row">
    <label>
      <span data-i18n="form.name">Name*</span>
      <input type="text" name="name" required />
    </label>
    <label>
      <span data-i18n="form.company">Company</span>
      <input type="text" name="company" />
    </label>
  </div>
  <div class="form-row">
    <label>
      <span data-i18n="form.country">Country*</span>
      <input type="text" name="country" required />
    </label>
    <label>
      <span data-i18n="form.email">Email*</span>
      <input type="email" name="email" required />
    </label>
  </div>
  <div class="form-row">
    <label>
      <span data-i18n="form.phone">WhatsApp / Phone</span>
      <input type="tel" name="phone" />
    </label>
    <label>
      <span data-i18n="form.quantity">Estimated Quantity</span>
      <input type="text" name="quantity" placeholder="e.g. 500 units" data-i18n-placeholder="form.quantityPlaceholder" />
    </label>
  </div>
  {formType === 'cooperation' && (
    <div class="form-row">
      <label class="full">
        <span data-i18n="form.businessType">Business Type*</span>
        <select name="businessType" required>
          <option value="" data-i18n="form.selectOption">Select...</option>
          <option value="distributor" data-i18n="form.distributorAgent">Distributor / Agent</option>
          <option value="oem" data-i18n="form.oemCustomization">OEM / Customization</option>
          <option value="project" data-i18n="form.projectBulkOrder">Project / Bulk Order</option>
        </select>
      </label>
    </div>
  )}
  <label class="full">
    <span data-i18n="form.message">Message*</span>
    <textarea name="message" rows="5" required>{prefillSubject}</textarea>
  </label>
  <button type="submit" class="btn btn--primary" data-i18n="form.submit">Send Inquiry</button>
  <p class="form-note" id="formNote"></p>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }
  label.full { width: 100%; }
  input, select, textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    border-radius: 2px;
  }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--glow);
  }
  .form-note { font-size: 13px; color: var(--steel); min-height: 18px; }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  // 表单提交逻辑：接入你选定的表单服务（如 Formspree / 自建API）后替换下面的 endpoint
  const form = document.getElementById('contactForm');
  const note = document.getElementById('formNote');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    note.textContent = 'Sending...';
    const formData = new FormData(form as HTMLFormElement);
    const payload = Object.fromEntries(formData.entries());

    try {
      // TODO: 替换成你实际的表单接收端点（详见 README 中"联系表单接入"说明）
      const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
      if (!endpoint) {
        note.textContent = 'Form endpoint not configured yet — see README.';
        return;
      }
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        note.textContent = 'Thank you! We will get back to you within 1 business day.';
        (form as HTMLFormElement).reset();
      } else {
        note.textContent = 'Something went wrong. Please try WhatsApp instead.';
      }
    } catch (err) {
      note.textContent = 'Something went wrong. Please try WhatsApp instead.';
    }
  });
</script>
