---
// 全局唯一实例，放在Layout里，任何页面的 .js-inquiry-btn 都能触发它
---
<div class="quick-inquiry-overlay" id="quickInquiryOverlay">
  <div class="quick-inquiry-modal">
    <button class="quick-inquiry-close" id="quickInquiryClose" aria-label="Close">&times;</button>
    <span class="eyebrow" data-i18n="modal.eyebrow">Quick Inquiry</span>
    <h3 id="quickInquiryTitle" data-i18n="modal.defaultTitle">Inquire About This Product</h3>
    <form id="quickInquiryForm">
      <input type="hidden" name="product" id="quickInquiryProduct" />
      <div class="qi-row">
        <label><span data-i18n="form.name">Name*</span><input type="text" name="name" required /></label>
        <label><span data-i18n="form.company">Company</span><input type="text" name="company" /></label>
      </div>
      <div class="qi-row">
        <label><span data-i18n="form.country">Country*</span><input type="text" name="country" required /></label>
        <label><span data-i18n="form.email">Email*</span><input type="email" name="email" required /></label>
      </div>
      <div class="qi-row">
        <label><span data-i18n="form.phone">WhatsApp / Phone</span><input type="tel" name="phone" /></label>
        <label><span data-i18n="form.quantity">Estimated Quantity</span><input type="text" name="quantity" placeholder="e.g. 500 units" data-i18n-placeholder="form.quantityPlaceholder" /></label>
      </div>
      <label class="full"><span data-i18n="form.message">Message</span><textarea name="message" rows="3" id="quickInquiryMessage"></textarea></label>
      <button type="submit" class="btn btn--primary" data-i18n="form.submit">Send Inquiry</button>
      <p class="qi-note" id="quickInquiryNote"></p>
    </form>
  </div>
</div>

<style>
  .quick-inquiry-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(14, 18, 32, 0.6);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .quick-inquiry-overlay.open { display: flex; }
  .quick-inquiry-modal {
    background: #fff;
    max-width: 520px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 36px;
    position: relative;
  }
  .quick-inquiry-close {
    position: absolute;
    top: 16px; right: 16px;
    background: none;
    border: none;
    font-size: 26px;
    line-height: 1;
    cursor: pointer;
    color: var(--text-muted);
  }
  .quick-inquiry-close:hover { color: var(--glow); }
  #quickInquiryTitle { font-size: 22px; margin-bottom: 20px; }

  .qi-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-bottom: 14px;
  }
  #quickInquiryForm label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
  }
  #quickInquiryForm label.full { width: 100%; margin-bottom: 16px; }
  #quickInquiryForm input,
  #quickInquiryForm textarea {
    font-family: var(--font-body);
    font-size: 15px;
    padding: 11px 13px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    border-radius: 2px;
  }
  #quickInquiryForm input:focus,
  #quickInquiryForm textarea:focus {
    outline: none;
    border-color: var(--glow);
  }
  .qi-note { font-size: 13px; color: var(--steel); min-height: 18px; margin-top: 10px; }

  @media (max-width: 560px) {
    .qi-row { grid-template-columns: 1fr; }
  }
</style>

<script>
  const overlay = document.getElementById('quickInquiryOverlay');
  const closeBtn = document.getElementById('quickInquiryClose');
  const titleEl = document.getElementById('quickInquiryTitle');
  const productField = document.getElementById('quickInquiryProduct') as HTMLInputElement | null;
  const messageField = document.getElementById('quickInquiryMessage') as HTMLTextAreaElement | null;
  const form = document.getElementById('quickInquiryForm');
  const note = document.getElementById('quickInquiryNote');

  function openModal(productName: string) {
    if (titleEl) titleEl.textContent = productName ? `Inquire About: ${productName}` : 'Quick Inquiry';
    if (productField) productField.value = productName || '';
    if (messageField) messageField.value = productName ? `I'm interested in: ${productName}` : '';
    overlay?.classList.add('open');
  }
  function closeModal() {
    overlay?.classList.remove('open');
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest('.js-inquiry-btn') as HTMLElement | null;
    if (trigger) {
      e.preventDefault();
      openModal(trigger.dataset.product || '');
    }
    if (target === overlay) closeModal();
  });
  closeBtn?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (note) note.textContent = 'Sending...';
    const formData = new FormData(form as HTMLFormElement);
    const payload = Object.fromEntries(formData.entries());
    try {
      const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT;
      if (!endpoint) {
        if (note) note.textContent = 'Form endpoint not configured yet — see README.';
        return;
      }
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (res.ok) {
        if (note) note.textContent = 'Thank you! We will get back to you within 1 business day.';
        (form as HTMLFormElement).reset();
      } else if (note) {
        note.textContent = 'Something went wrong. Please try WhatsApp instead.';
      }
    } catch (err) {
      if (note) note.textContent = 'Something went wrong. Please try WhatsApp instead.';
    }
  });
</script>
