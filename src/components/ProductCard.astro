---
import { urlFor } from '../lib/sanity';
import { productCategoryLabels } from '../lib/categories';
const { product } = Astro.props;
const imgUrl = product.coverImage ? urlFor(product.coverImage).width(600).height(450).url() : '/images/placeholder-product.jpg';
const detailUrl = `/products/${product.slug?.current}`;
const inquiryUrl = `/contact?product=${encodeURIComponent(product.name)}`;
// 卡片上最多展示3条参数要点，让采购商不用点进详情页就能判断是否符合需求
const topSpecs = (product.specs || []).slice(0, 3);
---
<div class="pcard">
  <a href={detailUrl} class="pcard__image">
    <img src={imgUrl} alt={product.name} loading="lazy" />
  </a>
  <div class="pcard__body">
    <span class="pcard__category" data-i18n={`cat.${product.category}`}>{productCategoryLabels[product.category] || product.category}</span>
    <a href={detailUrl}><h3 class="pcard__title">{product.name}</h3></a>
    {product.shortDescription && <p class="pcard__desc">{product.shortDescription}</p>}

    {topSpecs.length > 0 && (
      <ul class="pcard__specs">
        {topSpecs.map((s) => (
          <li><span class="pcard__spec-label">{s.label}</span><span class="pcard__spec-value">{s.value}</span></li>
        ))}
      </ul>
    )}

    <div class="pcard__actions">
      <a href={detailUrl} class="btn-mini btn-mini--outline" data-i18n="btn.details">Details</a>
      <a href={inquiryUrl} class="btn-mini btn-mini--solid" data-i18n="btn.inquiryNow">Inquiry Now</a>
    </div>
  </div>
</div>

<style>
  .pcard {
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    display: flex;
    flex-direction: column;
  }
  .pcard:hover {
    box-shadow: 0 18px 40px -18px rgba(14,18,32,0.25);
    transform: translateY(-3px);
  }
  .pcard__image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-soft);
  }
  .pcard__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcard:hover .pcard__image img { transform: scale(1.05); }
  .pcard__body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .pcard__category {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
  }
  .pcard__title {
    font-size: 17px;
    margin: 6px 0 6px;
  }
  .pcard__desc {
    font-size: 13px;
    margin: 0 0 12px;
    color: var(--text-muted);
  }
  .pcard__specs {
    list-style: none;
    margin: 0 0 16px;
    padding: 10px 0 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .pcard__specs li {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
    color: var(--text-muted);
  }
  .pcard__spec-value { color: var(--ink); font-weight: 500; }

  .pcard__actions {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }
  .btn-mini {
    flex: 1;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    padding: 9px 10px;
    border-radius: 2px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .btn-mini--outline {
    border-color: var(--line);
    color: var(--ink);
  }
  .btn-mini--outline:hover {
    border-color: var(--glow);
    color: var(--glow);
  }
  .btn-mini--solid {
    background: var(--glow);
    color: #fff;
  }
  .btn-mini--solid:hover {
    background: var(--glow-soft);
  }
</style>
