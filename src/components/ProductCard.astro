---
import { urlFor } from '../lib/sanity';
import { productCategoryLabels } from '../lib/categories';
// titleOverride：分类浏览页里，如果一个二级/三级分类下面只有1个真实产品，
// 会把这个产品直接当卡片展示（不用再点一层分组页），但卡片标题这时候要显示
// 分类名（比如"UFO Mining Floodlight"）而不是产品自己的具体型号名，
// 这样跟同一页面里其它"分组卡片"的标题风格保持一致。不传就还是显示产品名。
const { product, titleOverride } = Astro.props;
const displayTitle = titleOverride || product.name;
const imgUrl = product.coverImage ? urlFor(product.coverImage).width(600).height(450).url() : '/images/placeholder-product.jpg';
const detailUrl = `/products/${product.slug?.current}`;
const inquiryUrl = `/contact?product=${encodeURIComponent(product.name)}`;
const categoryUrl = `/products/category/${product.category}`;
---
<div class="pcard">
  <a href={detailUrl} class="pcard__image">
    <img src={imgUrl} alt={displayTitle} loading="lazy" />
  </a>
  <div class="pcard__body">
    <a href={categoryUrl} class="pcard__category" data-i18n={`cat.${product.category}`}>{productCategoryLabels[product.category] || product.category}</a>
    <a href={detailUrl}><h3 class="pcard__title">{displayTitle}</h3></a>
    {product.shortDescription && <p class="pcard__desc">{product.shortDescription}</p>}

    <div class="pcard__actions">
      <a href={detailUrl} class="btn-mini btn-mini--outline" data-i18n="btn.details">Details</a>
      <a href={inquiryUrl} class="btn-mini btn-mini--solid" data-i18n="btn.inquiryNow">Inquiry Now</a>
    </div>
  </div>
</div>

<style>
  .pcard {
    background: #fff;
    border: 1px solid var(--line);
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
    display: flex;
    flex-direction: column;
  }
  .pcard:hover {
    box-shadow: 0 18px 40px -18px rgba(14,18,32,0.25);
    transform: translateY(-3px);
  }
  .pcard__image {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-soft);
  }
  .pcard__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .pcard:hover .pcard__image img { transform: scale(1.05); }
  .pcard__body {
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .pcard__category {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--steel);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .pcard__category:hover { color: var(--glow); }
  .pcard__title {
    font-size: 19px;
    margin: 6px 0 6px;
  }
  .pcard__desc {
    font-size: 14px;
    margin: 0 0 12px;
    color: var(--text-muted);
  }
  .pcard__actions {
    margin-top: auto;
    display: flex;
    gap: 8px;
  }
  .btn-mini {
    flex: 1;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    padding: 9px 10px;
    border-radius: 2px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }
  .btn-mini--outline {
    border-color: var(--line);
    color: var(--ink);
  }
  .btn-mini--outline:hover {
    border-color: var(--glow);
    color: var(--glow);
  }
  .btn-mini--solid {
    background: var(--glow);
    color: #fff;
  }
  .btn-mini--solid:hover {
    background: var(--glow-soft);
  }
</style>
