---
const leftNavItems = [
  { label: 'Home', href: '/', i18n: 'nav.home' },
  { label: 'Products', href: '/products', i18n: 'nav.products' },
  { label: 'About Us', href: '/about', i18n: 'nav.about' },
];
const rightNavItems = [
  { label: 'News', href: '/news', i18n: 'nav.news' },
  { label: 'Cooperation', href: '/cooperation', i18n: 'nav.cooperation' },
];
const allNavItems = [...leftNavItems, ...rightNavItems];
const currentPath = Astro.url.pathname;
const isActive = (href) => currentPath === href || (href !== '/' && currentPath.startsWith(href));

const socialLinks = [
  {
    name: 'Facebook',
    href: '#',
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
  },
  {
    name: 'Instagram',
    href: '#',
    svg: '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>',
  },
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <div class="site-header__side site-header__side--left">
      <div class="site-header__social">
        {socialLinks.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.name} class="site-header__social-icon" set:html={s.svg} />
        ))}
      </div>
      <nav class="site-header__nav">
        {leftNavItems.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''} data-i18n={item.i18n}>{item.label}</a>
        ))}
      </nav>
    </div>

    <a href="/" class="site-header__logo">
      <img src="/images/logo/logo-mark-purple.png" alt="WLS Lighting" />
    </a>

    <div class="site-header__side site-header__side--right">
      <nav class="site-header__nav">
        {rightNavItems.map((item) => (
          <a href={item.href} class={isActive(item.href) ? 'active' : ''} data-i18n={item.i18n}>{item.label}</a>
        ))}
      </nav>
      <a href="/contact" class="btn btn--primary site-header__cta" data-i18n="nav.cta">Get a Quote</a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- 语言切换按钮固定在导航栏最右侧，独立于中间居中的菜单组 -->
  <div class="lang-switch lang-switch--float" role="group" aria-label="Language">
    <button type="button" class="lang-switch__btn" data-lang-btn="en">EN</button>
    <button type="button" class="lang-switch__btn" data-lang-btn="zh">中文</button>
  </div>

  <nav class="site-header__mobile-nav" id="siteNavMobile">
    {allNavItems.map((item) => (
      <a href={item.href} class={isActive(item.href) ? 'active' : ''} data-i18n={item.i18n}>{item.label}</a>
    ))}
    <div class="lang-switch lang-switch--mobile" role="group" aria-label="Language">
      <button type="button" class="lang-switch__btn" data-lang-btn="en">EN</button>
      <button type="button" class="lang-switch__btn" data-lang-btn="zh">中文</button>
    </div>
    <a href="/contact" class="btn btn--primary" data-i18n="nav.cta">Get a Quote</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ink);
    border-bottom: 1px solid rgba(255,255,255,0.15);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 88px;
    gap: 60px;
    max-width: 1520px;
    padding-left: 40px;
    padding-right: 40px;
  }

  .site-header__side {
    display: flex;
    align-items: center;
    gap: 36px;
    flex-shrink: 0;
  }

  .site-header__social {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .site-header__social-icon {
    display: flex;
    color: rgba(255,255,255,0.6);
    transition: color 0.2s ease;
  }
  .site-header__social-icon:hover { color: #fff; }

  .site-header__logo {
    display: flex;
    align-items: center;
    justify-self: center;
  }
  .site-header__logo img {
    height: 48px;
    width: auto;
    display: block;
  }

  .site-header__nav {
    display: flex;
    gap: 16px;
  }
  .site-header__nav a {
    color: rgba(255,255,255,0.75);
    font-size: 18px;
    font-weight: 500;
    padding: 12px 20px;
    border-radius: 6px;
    position: relative;
    white-space: nowrap;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .site-header__nav a:hover {
    color: #fff;
    background: var(--glow);
  }
  .site-header__nav a.active {
    color: #fff;
  }
  .site-header__nav a.active::after {
    content: '';
    position: absolute;
    left: 14px; right: 14px; bottom: -2px;
    height: 2px;
    background: #fff;
    box-shadow: 0 0 8px rgba(255,255,255,0.7);
  }
  .site-header__cta {
    padding: 15px 30px;
    font-size: 16px;
    background: #fff;
    color: var(--glow);
    white-space: nowrap;
  }
  .site-header__cta:hover {
    background: rgba(255,255,255,0.9);
  }

  .lang-switch {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(255,255,255,0.1);
    border-radius: 999px;
    padding: 3px;
    flex-shrink: 0;
  }
  .lang-switch__btn {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    color: rgba(255,255,255,0.65);
    background: transparent;
    border: none;
    border-radius: 999px;
    padding: 7px 16px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .lang-switch__btn:hover { color: #fff; }
  .lang-switch__btn.is-active {
    background: #fff;
    color: var(--glow);
  }
  .lang-switch--mobile { align-self: flex-start; }
  .lang-switch--float {
    position: absolute;
    top: 50%;
    right: 24px;
    transform: translateY(-50%);
    z-index: 10;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
  }
  .nav-toggle span {
    width: 22px; height: 2px; background: var(--paper);
  }

  .site-header__mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      display: flex;
      justify-content: space-between;
    }
    .site-header__side { display: none; }
    .nav-toggle { display: flex; }
    .lang-switch--float { display: none; }

    .site-header__mobile-nav.open {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 88px; left: 0; right: 0;
      background: var(--ink);
      padding: 20px 24px;
      gap: 18px;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }
    .site-header__mobile-nav a {
      color: rgba(255,255,255,0.85);
      font-size: 15px;
      font-weight: 500;
    }
    .site-header__mobile-nav a.active { color: #fff; }
    .site-header__mobile-nav .btn {
      align-self: flex-start;
      margin-top: 4px;
    }
  }
</style>

<script>
  const toggle = document.getElementById('navToggle');
  const mobileNav = document.getElementById('siteNavMobile');
  toggle?.addEventListener('click', () => mobileNav?.classList.toggle('open'));
</script>
