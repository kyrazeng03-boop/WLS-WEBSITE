# 复制这个文件为 .env，并填入你自己的值
# .env 文件不会被提交到代码仓库（已在 .gitignore 中忽略）

# Sanity 项目配置（在 Sanity 后台 -> Overview / API 中可以查到）
PUBLIC_SANITY_PROJECT_ID=f7nom1u6
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# 有写入权限的 Token，仅用于 Sanity Studio 本地开发和构建脚本
# 千万不要把真实 Token 提交到 git 仓库或发到聊天工具里
SANITY_API_TOKEN=your_token_here

# 联系表单接收邮箱（用于表单提交通知，可选，看你用哪种表单服务）
CONTACT_FORM_ENDPOINT=
